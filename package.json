{
  "name": "copeau",
  "version": "0.1.0",
  "description": "Interface web pour piloter une CNC Grbl / grblHAL",
  "author": "CodeNinjaPython",
  "homepage": "https://github.com/CodeNinjaPython/copeau",
  "repository": {
    "type": "git",
    "url": "https://github.com/CodeNinjaPython/copeau.git"
  },
  "desktopName": "copeau.desktop",
  "type": "module",
  "main": "desktop/main.js",
  "scripts": {
    "start": "node server/index.js",
    "desktop": "electron .",
    "build:portable": "electron-builder --win portable",
    "build:linux": "electron-builder --linux AppImage deb --x64 --publish never",
    "test": "eslint . && node --test test/*.test.js",
    "lint": "eslint ."
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "express": "^5.3.0",
    "marked": "18.1.2",
    "serialport": "^13.0.0",
    "three": "^0.187.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "eslint": "10.14.0",
    "globals": "17.14.0"
  },
  "build": {
    "appId": "fr.copeau.desktop",
    "productName": "Copeau",
    "directories": {
      "output": "dist"
    },
    "asarUnpack": [
      "**/*.node"
    ],
    "extraResources": [
      {
        "from": "node_modules/three/examples/jsm/controls/OrbitControls.js",
        "to": "three-addons/controls/OrbitControls.js"
      }
    ],
    "win": {
      "target": "portable",
      "artifactName": "Copeau-Portable-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "synopsis": "Interface pour piloter une CNC Grbl",
      "maintainer": "Copeau <noreply@github.com>",
      "syncDesktopName": true,
      "publish": null,
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "files": [
        "desktop/**/*",
        "server/**/*",
        "public/**/*",
        "docs/**/*"
      ]
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "udev"
      ]
    },
    "toolsets": {
      "appimage": "1.0.3"
    },
    "npmRebuild": false
  }
}
